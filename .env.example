APP_ENV=local

TRELLO_BOARD_URL=
TRELLO_LISTS=Novo PID,Em análise,Documentos Pendentes

USE_TEXTRACT_FALLBACK=true
TEXTRACT_MIN_CONFIDENCE=0.75
TEXTRACT_MAX_PAGES_PER_MONTH=3000
TEXTRACT_DAILY_SOFT_LIMIT=150

# Preferir AWS_PROFILE (perfil local ~/.aws/credentials)
AWS_PROFILE=pid-local
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY são lidos implicitamente pelo boto3
# se presentes no ambiente — não os coloque aqui em produção

PORTAL_URL=
